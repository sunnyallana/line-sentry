# ─────────────────────────────────────────────────────────────────────────────
# LineSentry — Rust backend (Axum) environment
# Copy to `backend/.env`. Variable names match the legacy Node server so the
# two are drop-in compatible; the extras at the bottom are Rust-specific.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime: set APP_ENV=production (or NODE_ENV=production) in production.
APP_ENV=development

# Address to bind (host:port). PORT is honoured if BIND_ADDR is unset.
BIND_ADDR=0.0.0.0:3001
# PORT=3001

# MongoDB (required). DB_NAME defaults to industrial_iot.
MONGODB_URI=mongodb://localhost:27017/industrial_iot
DB_NAME=industrial_iot

# JWT signing secret (required). Generate, e.g.:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Shared secret the PLC daemon presents via the X-API-Key header (required).
DAEMON_API_KEY=

# Google reCAPTCHA v2 secret (required in production; enforces login CAPTCHA).
RECAPTCHA_SECRET_KEY=

# Comma-separated allowed browser origins (CORS + Socket.IO).
CORS_ORIGIN=http://localhost:5173

# Optional: when set, Socket.IO uses the Redis adapter for horizontal scaling.
# REDIS_URL=redis://localhost:6379

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,linesentry_backend=debug
