# ─────────────────────────────────────────────────────────────────────────────
# LineSentry — Backend (Node/Express) environment
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real .env. Generate strong secrets (see comments below).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3001

# MongoDB connection string (required — server refuses to start without it).
#   Local:  mongodb://localhost:27017/industrial_iot
#   Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/industrial_iot
MONGODB_URI=mongodb://localhost:27017/industrial_iot

# JWT signing secret (required). Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime (e.g. 24h, 12h, 30m).
JWT_EXPIRES_IN=24h

# Shared secret the PLC daemon sends as the `X-API-Key` header on /api/signals/pin-data
# (required — ingestion is rejected without it). Generate the same way as JWT_SECRET.
DAEMON_API_KEY=

# Google reCAPTCHA v2 SECRET key (required in production — login verifies every attempt).
# The matching public site key goes in the FRONTEND env (VITE_RECAPTCHA_SITE_KEY).
RECAPTCHA_SECRET_KEY=

# Comma-separated list of allowed browser origins for CORS + Socket.IO.
#   Local dev:   http://localhost:5173
#   Production:  https://your-domain
CORS_ORIGIN=http://localhost:5173

# Rate limiting (optional overrides; sensible defaults applied if unset).
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_AUTH_MAX=5              # login attempts per window per IP
RATE_LIMIT_GENERAL_MAX=300        # general API requests per window per IP
