# ─────────────────────────────────────────────────────────────────────────────
# LineSentry — PLC signal daemon environment
# Copy to `.env` (loaded by your process manager / systemd) OR set these in the
# shell that launches the daemon. Values here override config.json.
# ─────────────────────────────────────────────────────────────────────────────

# Backend base URL the daemon POSTs signals to.
BACKEND_URL=http://localhost:3001

# Shared secret sent as the `X-API-Key` header. MUST match the backend's
# DAEMON_API_KEY, otherwise /api/signals/pin-data returns 401.
DAEMON_API_KEY=

# Optional: override polling/PLC settings (otherwise read from config.json).
# PLC_IP=192.168.0.1
# PLC_RACK=0
# PLC_SLOT=1
# INTERVAL_SECONDS=1
