# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose secrets — copy to deploy/.env (gitignored).
# Generate strong secrets, e.g.:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
DAEMON_API_KEY=
JWT_EXPIRES_IN=24h

# reCAPTCHA (optional in dev; required by the backend when APP_ENV=production).
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Public origin browsers use to reach the app (for CORS / Socket.IO).
CORS_ORIGIN=http://localhost
# Host port the frontend is published on.
WEB_PORT=80
