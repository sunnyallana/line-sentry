# LineSentry Rust daemon — environment overrides (take precedence over config.json).
# Loaded by systemd EnvironmentFile or your shell.

BACKEND_URL=http://localhost:3001
# Must match the backend's DAEMON_API_KEY.
DAEMON_API_KEY=

# "simulator" (default; no hardware) or "plc" (requires building with --features plc).
SOURCE=simulator
INTERVAL_SECONDS=1

# PLC connection (used when SOURCE=plc).
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1

RUST_LOG=info,linesentry_daemon=info
