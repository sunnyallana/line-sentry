# ─────────────────────────────────────────────────────────────────────────────
# LineSentry — Frontend (Vite) environment
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API.
#   Local dev:   http://localhost:3001/api
#   Production:  https://your-domain/api   (or "/api" when served behind the same nginx)
VITE_API_BASE_URL=http://localhost:3001/api

# Socket.IO server URL (real-time updates).
#   Local dev:   http://localhost:3001
#   Production:  https://your-domain      (or leave as same-origin behind nginx)
VITE_SOCKET_URL=http://localhost:3001

# Google reCAPTCHA v2 site key (public). Get one at https://www.google.com/recaptcha/admin
# The matching secret key goes in the BACKEND env (RECAPTCHA_SECRET_KEY), never here.
VITE_RECAPTCHA_SITE_KEY=
